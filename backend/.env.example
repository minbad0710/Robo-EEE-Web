# Copy this file to .env and fill in the real values. Never commit .env.

# MongoDB connection string. Special characters in the password must be URL-encoded (e.g. @ becomes %40).
DATABASE=mongodb://<user>:<password>@<host>:27017/RoboWeb?ssl=true&authSource=admin

PORT=5000

# Frontend URL(s) allowed to call the API from the browser, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Secret needed for POST / PATCH / DELETE requests, sent in the x-api-key header
ADMIN_API_KEY=change-me

# Cloudinary account for member photos (Cloudinary dashboard → API Keys)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
